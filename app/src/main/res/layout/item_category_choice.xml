<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/category_item_root"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="12dp"
    android:paddingRight="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_choice_manual"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:id="@+id/category_badge"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_choice_badge_manual">

        <com.pockie.app.PockieIcon
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:id="@+id/category_icon"
            app:iconName="category"
            app:iconTint="#F57200"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/category_name"
        android:fontFamily="@font/poppinsmedium"
        android:textSize="15sp"
        android:layout_weight="1"
        android:paddingLeft="14dp"
        android:paddingRight="8dp"
        android:textColor="#030505" />

    <com.pockie.app.PockieIcon
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:id="@+id/category_check"
        app:iconName="check"
        app:iconTint="#148BFF"
        android:importantForAccessibility="no"
        android:visibility="gone" />
</LinearLayout>

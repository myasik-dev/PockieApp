<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/empty_title"
        style="@style/Pockie.Text.Bold"
        android:text="@string/your_money_beautifully_organized"
        android:textSize="17sp"
        android:gravity="center" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/empty_message"
        style="@style/Pockie.Text"
        android:text="@string/add_your_first_expense_or_scan_your_bank_sms"
        android:textSize="14sp"
        android:gravity="center"
        android:textColor="#4E5760"
        android:layout_marginTop="8dp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:id="@+id/empty_action"
        style="@style/Pockie.Text.Bold"
        android:text="@string/add_a_transaction"
        android:textSize="16sp"
        android:gravity="center"
        android:background="@drawable/bg_button_black"
        android:textColor="#FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/add_a_transaction"
        android:layout_marginTop="20dp" />
</LinearLayout>

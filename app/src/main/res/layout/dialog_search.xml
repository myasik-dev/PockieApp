<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/dialog_title"
        style="@style/Pockie.Text.Bold"
        android:text="@string/search_transactions"
        android:textSize="20sp" />
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/search_input"
        android:singleLine="true"
        android:hint="@string/merchant_category_or_reference"
        android:layout_marginTop="12dp"
        android:inputType="text" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/dialog_cancel"
            style="@style/Pockie.Text"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:gravity="center"
            android:textColor="#4E5760"
            android:clickable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/dialog_clear"
            style="@style/Pockie.Text"
            android:text="@string/clear"
            android:textSize="14sp"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:gravity="center"
            android:textColor="#4E5760"
            android:clickable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/dialog_confirm"
            style="@style/Pockie.Text"
            android:text="@string/search"
            android:textSize="14sp"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:gravity="center"
            android:textColor="#148BFF"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>

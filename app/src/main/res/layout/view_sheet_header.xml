<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_handle" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/sheet_title"
            style="@style/Pockie.Text.Bold"
            android:text="@string/transaction_details"
            android:textSize="20sp"
            android:layout_weight="1" />
        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:id="@+id/sheet_close"
            android:contentDescription="@string/close"
            android:clickable="true"
            android:focusable="true">
            <com.pockie.app.PockieIcon
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:iconName="close"
                app:iconTint="#303943"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/sheet_subtitle"
        style="@style/Pockie.Text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_a_quick_way_to_add_your_income_or_expense"
        android:textColor="#45565B"
        android:textSize="14sp" />

    <Space android:layout_width="match_parent" android:layout_height="16dp" />
</LinearLayout>

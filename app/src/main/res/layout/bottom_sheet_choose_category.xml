<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <include layout="@layout/view_sheet_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:id="@+id/category_search_container"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_search_bar"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:layout_marginBottom="14dp">

        <com.pockie.app.PockieIcon
            android:layout_width="18dp"
            android:layout_height="18dp"
            app:iconName="search"
            app:iconTint="#4E5760"
            android:importantForAccessibility="no" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/category_search"
            style="@style/Pockie.Text"
            android:hint="Search category..."
            android:textSize="14sp"
            android:background="@null"
            android:paddingLeft="10dp"
            android:singleLine="true"
            android:textColor="#030505"
            android:textColorHint="#8E99A4"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:id="@+id/category_scroll"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/category_list_container"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>

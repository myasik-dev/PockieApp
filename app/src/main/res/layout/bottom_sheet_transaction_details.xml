<?xml version='1.0' encoding='utf-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">
        <include layout="@layout/view_sheet_header" />
        <include
            layout="@layout/item_transaction"
            android:id="@+id/detail_transaction_summary"
            android:layout_width="match_parent"
            android:layout_height="64dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D6D7DD"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="18dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/transaction_detail_fields"
            android:orientation="vertical" />
        <Space android:layout_width="match_parent" android:layout_height="22dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:id="@+id/edit_transaction"
                style="@style/Pockie.Text.Bold"
                android:text="@string/edit"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_button_edit"
                android:textColor="#148BFF"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/edit"
                android:layout_weight="1"
                android:layout_marginEnd="12dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:id="@+id/delete_transaction"
                style="@style/Pockie.Text.Bold"
                android:text="@string/delete"
                android:textSize="16sp"
                android:gravity="center"
                android:background="@drawable/bg_button_delete"
                android:textColor="#FF242D"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/delete"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

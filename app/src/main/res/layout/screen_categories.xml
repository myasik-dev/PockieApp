<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/categories_empty"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:id="@+id/categories_scroll"
        android:scrollbars="none">
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/categories_grid"
            android:columnCount="2"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="28dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_food"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/cat_food"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_food"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/food"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_food"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_food"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_fuel"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/cat_fuel"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_fuel"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/fuel"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_fuel"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_fuel"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_shopping"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/cat_shopping"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_shopping"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/shopping"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_shopping"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_shopping"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_business"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_category_card"
                android:backgroundTint="#E0DCFF"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_business"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/business"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:layout_marginBottom="5dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_business"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_business"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_recharge"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_category_card"
                android:backgroundTint="#CBFAEF"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_recharge"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/recharge"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_recharge"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_recharge"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/card_transfers"
                android:orientation="vertical"
                android:layout_columnWeight="1"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="16dp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_category_card"
                android:backgroundTint="#FFF2B1"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:src="@drawable/category_transfers"
                    android:scaleType="fitCenter"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/transfers"
                        android:textSize="16sp"
                        android:layout_weight="1" />
                    <com.pockie.app.PockieIcon
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        app:iconName="next"
                        app:iconTint="#030505"
                        android:importantForAccessibility="no" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:layout_marginBottom="5dp"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_amount_transfers"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0"
                        android:textSize="14sp"
                        android:layout_weight="1"
                        android:textColor="#4E5760" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/category_count_transfers"
                        style="@style/Pockie.Text"
                        android:text="@string/text_0_2"
                        android:textSize="14sp"
                        android:textColor="#4E5760" />
                </LinearLayout>
            </LinearLayout>
        </GridLayout>
    </ScrollView>
</LinearLayout>


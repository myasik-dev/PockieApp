<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/dialog_title"
        style="@style/Pockie.Text.Bold"
        android:text="@string/bank_filter"
        android:textSize="20sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/Pockie.Text"
        android:text="@string/no_banks_selected_means_all_banks"
        android:textSize="12sp"
        android:textColor="#4E5760"
        android:layout_marginTop="6dp" />
    <ListView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:id="@+id/bank_choices"
        android:choiceMode="multipleChoice"
        android:divider="@android:color/transparent"
        android:dividerHeight="0dp"
        android:layout_marginTop="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/all_banks"
            style="@style/Pockie.Text"
            android:text="@string/all_banks"
            android:textSize="14sp"
            android:paddingRight="16dp"
            android:gravity="center"
            android:textColor="#148BFF"
            android:clickable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/dialog_cancel"
            style="@style/Pockie.Text"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:paddingRight="16dp"
            android:gravity="center"
            android:textColor="#4E5760"
            android:clickable="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:id="@+id/dialog_confirm"
            style="@style/Pockie.Text"
            android:text="@string/save"
            android:textSize="14sp"
            android:gravity="center"
            android:textColor="#148BFF"
            android:clickable="true" />
    </LinearLayout>
</LinearLayout>

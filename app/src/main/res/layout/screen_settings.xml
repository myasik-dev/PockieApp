<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">
    <include layout="@layout/view_toolbar" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="28dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:background="@drawable/bg_settings_banner"
                android:layout_marginBottom="22dp">
                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="72dp"
                    android:src="@drawable/mascot_settings"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingLeft="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tracking_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/make_tracking_automatic"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/tracking_description"
                        style="@style/Pockie.Text"
                        android:text="@string/enable_access_to_track_bank_transactions"
                        android:textSize="14sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:id="@+id/setting_sms"
                android:orientation="horizontal"
                android:gravity="top"
                android:visibility="visible">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_sms_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/sms_access"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_sms_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/automatically_reads_bank_sms_to_track_your_expense"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="4dp"
                        android:visibility="visible" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:id="@+id/setting_sms_switch"
                    android:contentDescription="@string/sms_access"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_green" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:id="@+id/setting_notifications"
                android:orientation="horizontal"
                android:gravity="top"
                android:visibility="visible">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_notifications_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/notification_access"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_notifications_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/automatically_reads_bank_notifications_to_track_your_expense"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="4dp"
                        android:visibility="visible" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:id="@+id/setting_notifications_switch"
                    android:contentDescription="@string/notification_access"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_green" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:id="@+id/setting_banks"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bank_filter">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_banks_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/bank_filter"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_banks_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/all_banks"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp"
                        android:visibility="visible" />
                </LinearLayout>
                <com.pockie.app.PockieIcon
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    app:iconName="next"
                    app:iconTint="#38435C"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="74dp"
                android:id="@+id/setting_transfers"
                android:orientation="horizontal"
                android:gravity="top"
                android:visibility="visible">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_transfers_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/exclude_transfer"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_transfers_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/mark_internal_transfer"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="4dp"
                        android:visibility="visible" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:layout_width="42dp"
                    android:layout_height="40dp"
                    android:id="@+id/setting_transfers_switch"
                    android:contentDescription="@string/exclude_transfer"
                    app:thumbTint="#FFFFFF"
                    app:trackTint="@color/switch_track_blue" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:id="@+id/setting_backup"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/backup_export">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_backup_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/backup_export"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_backup_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/export_your_data"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp"
                        android:visibility="visible" />
                </LinearLayout>
                <com.pockie.app.PockieIcon
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    app:iconName="next"
                    app:iconTint="#38435C"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/setting_privacy"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/privacy_security">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_privacy_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/privacy_security"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_privacy_subtitle"
                        style="@style/Pockie.Text"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp"
                        android:visibility="gone" />
                </LinearLayout>
                <com.pockie.app.PockieIcon
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    app:iconName="next"
                    app:iconTint="#38435C"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:id="@+id/setting_about"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="visible"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/about">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_about_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/about"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_about_subtitle"
                        style="@style/Pockie.Text"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp"
                        android:visibility="gone" />
                </LinearLayout>
                <com.pockie.app.PockieIcon
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    app:iconName="next"
                    app:iconTint="#38435C"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:id="@+id/setting_clear_demo"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/clear_sample_data">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:paddingTop="0dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_clear_demo_title"
                        style="@style/Pockie.Text.Bold"
                        android:text="@string/clear_sample_data"
                        android:textSize="14sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/setting_clear_demo_subtitle"
                        style="@style/Pockie.Text"
                        android:text="@string/keep_your_own_transactions"
                        android:textSize="12sp"
                        android:textColor="#45565B"
                        android:layout_marginTop="5dp"
                        android:visibility="visible" />
                </LinearLayout>
                <com.pockie.app.PockieIcon
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    app:iconName="next"
                    app:iconTint="#38435C"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

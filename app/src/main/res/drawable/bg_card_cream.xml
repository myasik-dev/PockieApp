<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer edge / rim -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <solid android:color="#FFE39C" />
        </shape>
    </item>

    <!-- Outer-to-inner soft transition 1 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <solid android:color="#FFEEB8" />
        </shape>
    </item>

    <!-- Outer-to-inner soft transition 2 -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FFF8DC" />
        </shape>
    </item>

    <!-- Inner main cream background -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <solid android:color="#FFFDF4" />
        </shape>
    </item>
</layer-list>
